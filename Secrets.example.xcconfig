// Copy this file to `Secrets.xcconfig` and fill in your key:
//
//     cp Secrets.example.xcconfig Secrets.xcconfig
//
// `Secrets.xcconfig` is gitignored. Never commit it — this repository is public,
// and a committed key is a revoked key within minutes of GitHub's secret scanner
// reaching it.
//
// Get a key at https:/​/openrouter.ai/keys
//
// The app reads OpenRouterAPIKey from its Info.plist on first launch, moves it
// into the Keychain, and reads it from there afterwards. Archiving for the App
// Store picks this file up automatically, because Config/Base.xcconfig includes
// it and both Debug and Release inherit from Base.
//
// For CI, do not create this file: inject the value instead, e.g.
//     xcodebuild ... OPENROUTER_API_KEY="$OPENROUTER_API_KEY"

OPENROUTER_API_KEY =
OPENROUTER_SITE_URL = https:$(SLASH)$(SLASH)github.com$(SLASH)rajatslakhina$(SLASH)ai-chat-app
OPENROUTER_APP_NAME = AI Chat
